{
  "mcpServers": {
    "youtrack": {
      "type": "http",
      "url": "https://protomated.youtrack.cloud/mcp",
      "headers": {
        "Authorization": "Bearer ${YOUTRACK_API_TOKEN}"
      }
    },
    "nifty-claude-code": {
      "type": "http",
      "url": "https://mcp.niftypm.com/mcp",
      "headers": {
        "Authorization": "Bearer ${NIFTY_API_TOKEN}"
      }
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.inkeep.com/better-auth/mcp"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "basehub": {
      "type": "http",
      "url": "https://basehub.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${BASEHUB_MCP_TOKEN}"
      }
    },
    "trigger": {
      "command": "npx",
      "args": ["trigger.dev@latest", "mcp"]
    },
    "semrush": {
      "type": "http",
      "url": "https://mcp.semrush.com/v1/mcp"
    }
  }
}
