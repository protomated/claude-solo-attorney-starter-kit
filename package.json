{
  "name": "solo-attorney-starter-kit",
  "version": "2.0.0",
  "description": "Solo Attorney Claude Starter Kit — Claude Desktop plugin for solo attorneys",
  "private": true,
  "scripts": {
    "validate": "node scripts/validate-plugin.mjs plugin",
    "pack": "rm -f /tmp/solo-attorney-starter-kit.zip && (cd plugin && zip -r /tmp/solo-attorney-starter-kit.zip . -x '*.DS_Store' 'node_modules/*' '*/node_modules/*' 'package-lock.json') && mv /tmp/solo-attorney-starter-kit.zip ./solo-attorney-starter-kit-v$npm_package_version.zip",
    "checksum": "sha256sum solo-attorney-starter-kit-v$npm_package_version.zip | tee solo-attorney-starter-kit-v$npm_package_version.zip.sha256",
    "deploy:artifact": "mkdir -p site/public/downloads && cp solo-attorney-starter-kit-v$npm_package_version.zip site/public/downloads/solo-attorney-starter-kit.zip",
    "build": "npm run validate && npm run pack && npm run checksum && npm run deploy:artifact",
    "release": "npm run build && gh release create v$npm_package_version solo-attorney-starter-kit-v$npm_package_version.zip solo-attorney-starter-kit-v$npm_package_version.zip.sha256 --title \"v$npm_package_version\" --notes-file RELEASE.md",
    "clean": "rm -f ./*.zip ./*.zip.sha256",
    "tree": "find plugin -type f -not -path '*/node_modules/*' | sort",
    "site:install": "npm install --prefix site",
    "site:dev": "npm run dev --prefix site",
    "site:build": "npm run build --prefix site",
    "site:preview": "npm run preview --prefix site",
    "site:deploy": "npm run deploy --prefix site"
  }
}
