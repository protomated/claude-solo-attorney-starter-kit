{
  "name": "solo-attorney-assistant",
  "version": "1.0.0",
  "description": "Solo Attorney Assistant — Claude Cowork plugin for solo attorneys",
  "private": true,
  "scripts": {
    "validate": "node scripts/validate-plugin.mjs plugin",
    "pack": "rm -f /tmp/solo-attorney-assistant.zip && (cd plugin && zip -r /tmp/solo-attorney-assistant.zip . -x '*.DS_Store' 'node_modules/*' '*/node_modules/*' 'package-lock.json') && mv /tmp/solo-attorney-assistant.zip ./solo-attorney-assistant-v$npm_package_version.zip",
    "checksum": "sha256sum solo-attorney-assistant-v$npm_package_version.zip | tee solo-attorney-assistant-v$npm_package_version.zip.sha256",
    "deploy:artifact": "mkdir -p site/public/downloads && cp solo-attorney-assistant-v$npm_package_version.zip site/public/downloads/solo-attorney-assistant.zip",
    "build": "npm run validate && npm run pack && npm run checksum && npm run deploy:artifact",
    "release": "git tag v$npm_package_version && git push origin v$npm_package_version",
    "clean": "rm -f ./*.zip ./*.zip.sha256",
    "tree": "find plugin -type f -not -path '*/node_modules/*' | sort",
    "site:install": "npm install --prefix site",
    "site:dev": "npm run dev --prefix site",
    "site:build": "npm run build --prefix site",
    "site:preview": "npm run preview --prefix site"
  }
}
