{
  "mcpServers": {
    "youtrack": {
      "type": "http",
      "url": "https://protomated.youtrack.cloud/mcp",
      "headers": {
        "Authorization": "Bearer perm-ZW1tYW51ZWwuZQ==.NDMtMTE=.I4pdLhLYOSrbXFAxIiEtwQMQCHJJYd"
      }
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.inkeep.com/better-auth/mcp"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "YOUR_CONTEXT7_API_KEY"
      }
    },
    "basehub": {
      "type": "http",
      "url": "https://basehub.com/api/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_BASEHUB_MCP_TOKEN"
      }
    },
    "trigger": {
      "command": "npx",
      "args": ["trigger.dev@latest", "mcp"]
    },
    "semrush": {
      "type": "http",
      "url": "https://mcp.semrush.com/v1/mcp"
    }
  }
}
